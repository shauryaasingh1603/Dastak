{
  "framework": null,
  "installCommand": "echo 'Flutter is installed by the build step'",
  "buildCommand": "bash tool/vercel_build.sh",
  "outputDirectory": "build/web",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
